# Copiá este archivo como .env y completá los valores
# Solo desarrollo: enciende DEBUG (admin de Django, clave de desarrollo, correo por consola, sin redirección a https).
# Sin esta variable DEBUG queda apagado, que es lo que corresponde en Render (allí va DJANGO_DEBUG=0).
DJANGO_DEBUG=1
DB_PASSWORD=postgres
# Nombre de la organización que se muestra en la cabecera (opcional; por defecto, InfoPonia)
NOMBRE_ORGANIZACION=Jardín Botánico

# Correo del sistema (D-33, recuperar contraseña). Gmail por SMTP: el usuario es la cuenta de notificaciones y la
# contraseña es una contraseña de aplicación de Google, no la de la cuenta. Solo en las variables de entorno de
# Render: nunca en el código. Sin las dos, la recuperación por correo no está disponible.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Solo desarrollo: con DJANGO_DEBUG=1, poné CORREO_CONSOLA=1 para ver los correos en la consola de runserver, sin
# credenciales. Con DJANGO_DEBUG=0 se ignora.
CORREO_CONSOLA=

# Demo de la defensa (D-NN, comando cargar_demo; solo en el servicio demo de Render, nunca en produccion ni en desarrollo).
# INFOPONIA_DEMO=1 instala la app demo; la contrasena de las cuentas y la base de los correos (la parte antes de @gmail.com) son secretos: no los pongas aca.
# INFOPONIA_DEMO=
# INFOPONIA_DEMO_CONTRASENA=
# INFOPONIA_DEMO_CORREO=
